# Reseller Scout — environment template
# Copy to .env and fill in. .env is gitignored.

# ---- eBay Finding API (UK marketplace, EBAY-GB) ----
# Register at https://developer.ebay.com/my/keys
# Production keys (use for real sold-listing queries)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
# Sandbox keys (useful for dry-runs that don't count against prod rate limits)
EBAY_SANDBOX_APP_ID=
EBAY_SANDBOX_CERT_ID=
EBAY_SANDBOX_DEV_ID=
# Environment: "production" or "sandbox"
EBAY_ENV=production

# ---- Vision models (Day 1 benchmark — one wins Day 2) ----
# OpenAI GPT-Image-1.5 (or gpt-4.1-mini/vision in 2026, depending on API naming)
OPENAI_API_KEY=
# Replicate (FLUX.2 Pro runs here)
REPLICATE_API_TOKEN=

# ---- Supabase (Day 2+; storage + auth) ----
# EXPO_PUBLIC_ prefix required to expose to the React Native bundle
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- RevenueCat (Day 5) ----
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
