# WorthIt — environment template
# Copy to .env and fill in. .env is gitignored.
#
# Conventions:
#  - EXPO_PUBLIC_* — exposed to the RN bundle at build-time.
#  - Anything else — Node-only (scripts in scripts/, server-side keys).
#
# SECURITY NOTE (Day 4+):
# The Anthropic API key is NEVER in the app bundle. Calls route through the
# anthropic-proxy Edge Function, which holds the key in Supabase project secrets.
# See supabase/functions/anthropic-proxy/index.ts for the full rationale.

# ---- Anthropic (Claude Opus 4.7 — Flow A; Sonnet 4.6 — Flow B + tier-2 fallback) ----
# Node-side only — used by scripts/benchmark-vision.ts and by `supabase secrets set`
# before deploying the Edge Function. NEVER referenced from the app bundle.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Override default model ids if needed:
# ANTHROPIC_VISION_MODEL=claude-opus-4-7
# ANTHROPIC_VISION_MODEL_TIER2=claude-sonnet-4-6

# ---- Supabase ----
# Project URL + anon key (both safe to ship in the bundle — anon key is scoped by RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only. Never in the bundle. Used by scripts/migrations.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic proxy (Edge Function) ----
# Deployed URL of the anthropic-proxy Edge Function.
# Typical shape: https://<project-ref>.supabase.co/functions/v1/anthropic-proxy
EXPO_PUBLIC_PROXY_URL=

# Shared-secret header the bundle sends with every proxy call. Must MATCH the
# PROXY_SHARED_SECRET secret set on the Edge Function via:
#   supabase secrets set PROXY_SHARED_SECRET=<random-hex-32>
# Generate with: `openssl rand -hex 32` (or any 32-byte random).
# Note: this secret IS in the bundle — same extraction risk as any bundle secret,
# but the blast radius is bounded by Supabase + Anthropic rate limits. See
# supabase/functions/anthropic-proxy/index.ts for full reasoning.
EXPO_PUBLIC_PROXY_SHARED_SECRET=

# ---- RevenueCat ----
# iOS SDK key from RevenueCat dashboard → Project → API Keys → Public app-specific.
# https://app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ---- Track B — data pipeline (not on the user-request path) ----
# Deferred per the Day 2 scope pivot — build kicked off in a later session.
# Uncomment when Track B work resumes. Never used from the app bundle.
# APIFY_API_TOKEN=
# IPROYAL_PROXY_USER=
# IPROYAL_PROXY_PASS=

# ---- Benchmark-only (NOT used in app v1) ----
# Re-enable post-launch for a 3-way vision re-benchmark if Opus accuracy plateaus.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-5.4
# GOOGLE_AI_API_KEY=
# GOOGLE_VISION_MODEL=gemini-3.1-pro
