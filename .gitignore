# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.*.local

# benchmark data (fiancée photos kept local, never committed)
scripts/benchmark-items/*.jpg
scripts/benchmark-items/*.jpeg
scripts/benchmark-items/*.png
scripts/benchmark-items/*.heic
scripts/benchmark-items/*.truth.json
!scripts/benchmark-items/.gitkeep
!scripts/benchmark-items/README.md
!scripts/benchmark-items/example.truth.json

# benchmark output
docs/model-benchmark-results-*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
